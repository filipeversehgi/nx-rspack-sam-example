{
  "name": "random-color",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/random-color/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/random-color",
        "tsConfig": "libs/random-color/tsconfig.lib.json",
        "packageJson": "libs/random-color/package.json",
        "main": "libs/random-color/src/index.ts",
        "assets": [],
        "compiler": "tsc",
        "target": "node",
        "webpackConfig": "libs/random-color/webpack.config.ts"
      }
    },
    "serve": {
      "executor": "@nx/webpack:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "random-color:build",
        "runBuildTargetDependencies": false,
        "watch": false,
        "port": 3001,
        "allowedHosts": ".ngrok-free.app"
      }
    }
  }
}
